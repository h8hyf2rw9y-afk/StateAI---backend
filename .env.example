# Postgres connection string for SQLAlchemy/Alembic — from your Supabase
# project's dashboard: Project Settings -> Database -> Connection string
# (choose the SQLAlchemy/psycopg-compatible URI, "Session pooler" or direct
# connection both work). This is a NEW secret, distinct from anything the
# frontend uses — it includes your database password. Never commit a real
# value for this.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require

# Same Supabase project URL the frontend uses (NEXT_PUBLIC_SUPABASE_URL).
# Used to build the JWKS endpoint this backend verifies Supabase Auth
# tokens against — see app/core/security.py. Not a secret.
SUPABASE_URL=https://your-project-ref.supabase.co

# The "aud" claim every valid Supabase Auth access token carries. Almost
# never needs to change from the default.
SUPABASE_JWT_AUD=authenticated

# Comma-separated list of origins allowed to call this API (CORS). Add your
# production frontend URL here once you have one, alongside localhost.
FRONTEND_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Do NOT add a Supabase service_role key here — it isn't needed for JWT
# verification (which only uses Supabase's public JWKS keys) and bypasses
# all Row Level Security if it ever leaks. This file is committed to git —
# only ever put placeholders here. Real values go in .env (gitignored).
# ---------------------------------------------------------------------------

# Which LLMProvider the Lead Intelligence Agent uses (app/ai/llm/factory.py):
# "ollama" (the default) runs entirely locally, no API key, no cost — good
# for development. "anthropic" is the production option (see below).
LLM_PROVIDER=ollama

# Only used when LLM_PROVIDER=ollama. Requires Ollama (https://ollama.com)
# installed and running locally, with OLLAMA_MODEL already pulled
# (`ollama pull llama3.2`). See the "Lead Intelligence Agent" README section
# for exact setup commands.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# How long to wait for one Ollama response before timing out. Originally set
# to 180s on the assumption that was generous for CPU-only hardware with
# llama3.2; live QA testing (CRM Integration & QA phase) measured real,
# otherwise-healthy calls taking anywhere from ~118s to ~185s on this exact
# CPU-only setup, so 180s produced real, reproducible LLMTimeoutErrors on
# roughly half of a small sample of genuine calls — not a code bug, but an
# under-provisioned default. Raised to 240s for real headroom; raise it
# further still if you see LLMTimeoutError with a larger/GPU-less model,
# lower it if you have GPU acceleration. If you change this, also update
# frontend's AI_AGENT_TIMEOUT_MS (lib/api/ai.ts) to stay comfortably above it,
# or the frontend will abort its own fetch before the backend's clean 504
# response ever arrives.
OLLAMA_TIMEOUT_SECONDS=240

# Only used when LLM_PROVIDER=anthropic — get one at
# https://console.anthropic.com/settings/keys. With LLM_PROVIDER=anthropic
# and this unset, POST /api/v1/ai/lead-intelligence/{contact_id} responds
# 503 rather than failing with a raw provider error. Never commit a real
# value — only ever put a placeholder here.
ANTHROPIC_API_KEY=

# The Anthropic model the agent calls when LLM_PROVIDER=anthropic — kept
# out of application code so it can be updated (e.g. to a newer model)
# without a code change. See app/core/config.py for the default.
ANTHROPIC_MODEL=claude-sonnet-5
